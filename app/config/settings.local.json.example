{
  "app": {
    "baseUrl": "http://localhost:3000",
    "publicBaseUrl": "http://localhost:3000",
    "adminAccessToken": "dev-admin-token"
  },
  "database": {
    "provider": "postgresql",
    "url": "postgresql://vgen:vgen@localhost:5432/vgen"
  },
  "redis": {
    "url": "redis://localhost:6379"
  },
  "render": {
    "defaultWidth": 1080,
    "defaultHeight": 1920,
    "defaultFps": 30,
    "defaultFormat": "mp4",
    "outputDirectory": "./tmp/renders",
    "concurrency": 1
  },
  "storage": {
    "provider": "mock",
    "internalApiBaseUrl": "",
    "accessToken": ""
  },
  "tts": {
    "provider": "mock",
    "internalApiBaseUrl": "",
    "accessToken": "",
    "defaultVoice": "default"
  },
  "mediaSource": {
    "provider": "mock",
    "internalApiBaseUrl": "",
    "accessToken": "",
    "enableDescriptionSearch": false
  },
  "featureFlags": {
    "enableFetchMediaByDescription": false,
    "enableIntroVideoFlow": true,
    "enableCompositeVideoFlow": true
  }
}
