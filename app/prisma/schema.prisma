generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_CONNECTION_STRING")
}

model SystemSettings {
  id           Int      @id @default(1)
  settingsJson String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model RenderJob {
  id           String    @id
  type         String
  status       String
  requestJson  String
  resultJson   String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?

  assets RenderAsset[]
  events RenderJobEvent[]
}

model RenderAsset {
  id           String   @id
  renderJobId  String
  kind         String
  source       String
  url          String
  localPath    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  renderJob RenderJob @relation(fields: [renderJobId], references: [id])
}

model RenderJobEvent {
  id           String   @id
  renderJobId  String
  level        String
  message      String
  metadataJson String?
  createdAt    DateTime @default(now())

  renderJob RenderJob @relation(fields: [renderJobId], references: [id])
}
